#!/usr/bin/python3
import json
import hashlib
import os
import re
import runpy
import subprocess
import sys
from pathlib import Path

SYNC_KEYS = ("BL_SYNC_FALLBACK", "BL_FSYNC_FIRST", "BL_SYNC_MIN_NOFILE", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC", "PROTON_NO_NTSYNC", "WINEESYNC")
SEED_REDISTS = "/usr/local/bin/droiddeck-seed-redists"
PACK_KEYS = ("WINESERVER", "BL_SYNC_PACK", "WINEESYNC", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC")
PROFILE_VERSION = re.compile(r"[0-9a-f]{64}")
PROFILE_DLLS = ("d3d8.dll", "d3d9.dll", "d3d10core.dll", "d3d11.dll", "dxgi.dll")
PROFILE_CRITICAL = (
    "run-proton.py",
    *("dxvk/%s/%s" % (arch, dll) for arch in ("x32", "x64") for dll in PROFILE_DLLS),
    "wsi/libVkLayer_window_system_integration.so",
    "wsi/VkLayer_window_system_integration.json",
)
PROFILE_KEYS = (
    "DROIDDECK_PROTON_WRAPPER", "HYBRIS_BC_TEXTURES", "VK_LAYER_PATH", "VK_INSTANCE_LAYERS",
    "ENABLE_GAMESCOPE_WSI", "VK_LOADER_LAYERS_DISABLE", "DISABLE_WSI_LAYER",
    "PROTON_USE_WINED3D", "DISABLE_VK_LAYER_VALVE_steam_fossilize_1",
    "ENABLE_VK_LAYER_VALVE_steam_fossilize_1",
)
PROFILE_MANIFEST_LIMIT = 1024 * 1024
PROFILE_RECEIPT_LIMIT = 128


class GraphicsProfileError(ValueError):
    pass


def file_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def profile_file(pack, relative):
    if (not isinstance(relative, str) or not relative or relative.startswith("/") or
            "\\" in relative or "\0" in relative):
        raise GraphicsProfileError("invalid managed file path")
    if any(part in ("", ".", "..") for part in relative.split("/")):
        raise GraphicsProfileError("invalid managed file path")
    candidate = pack.joinpath(*relative.split("/"))
    if candidate.is_symlink():
        raise GraphicsProfileError("managed file is a symbolic link: %s" % relative)
    try:
        resolved = candidate.resolve(strict=True)
    except (OSError, RuntimeError) as error:
        raise GraphicsProfileError("managed file is missing: %s" % relative) from error
    try:
        inside = os.path.commonpath((str(pack), str(resolved))) == str(pack)
    except ValueError:
        inside = False
    if not inside:
        raise GraphicsProfileError("managed file escapes the selected pack: %s" % relative)
    return resolved


def validate_profile_tree(pack, expected_files):
    expected_directories = set()
    for relative in expected_files:
        parent = Path(relative).parent
        while str(parent) != ".":
            expected_directories.add(parent.as_posix())
            parent = parent.parent
    for folder, directories, files in os.walk(pack, followlinks=False):
        folder = Path(folder)
        for name in directories:
            entry = folder / name
            relative = entry.relative_to(pack).as_posix()
            if entry.is_symlink() or relative not in expected_directories:
                raise GraphicsProfileError("graphics profile contains an unexpected entry: %s" % relative)
        for name in files:
            entry = folder / name
            relative = entry.relative_to(pack).as_posix()
            if entry.is_symlink() or relative not in expected_files:
                raise GraphicsProfileError("graphics profile contains an unexpected entry: %s" % relative)


def validate_profile(profile):
    if not isinstance(profile, dict) or profile.get("format") != 1:
        raise GraphicsProfileError("unsupported graphics profile selection")
    version = profile.get("version")
    if not isinstance(version, str) or not PROFILE_VERSION.fullmatch(version):
        raise GraphicsProfileError("invalid graphics profile version")
    base_value = profile.get("packBase")
    if not isinstance(base_value, str):
        raise GraphicsProfileError("invalid graphics profile directory")
    published_base = Path(base_value)
    if not published_base.is_absolute() or tuple(published_base.parts[-3:]) != ("files", "graphics_profiles", "packs"):
        raise GraphicsProfileError("graphics profile directory is outside app storage")
    try:
        base = published_base.resolve(strict=True)
        pack = (base / version).resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        raise GraphicsProfileError("selected graphics profile is not installed") from error
    if pack.parent != base or pack.name != version or not pack.is_dir():
        raise GraphicsProfileError("selected graphics profile directory is invalid")

    published_files_dir = published_base.parent.parent
    published_pack = published_base / version
    hybris_value = profile.get("hybrisRuntime")
    if not isinstance(hybris_value, str):
        raise GraphicsProfileError("invalid system Vulkan runtime directory")
    hybris = Path(hybris_value)
    if (not hybris.is_absolute() or hybris.parent != published_files_dir / "system_vulkan" or
            not PROFILE_VERSION.fullmatch(hybris.name)):
        raise GraphicsProfileError("system Vulkan runtime is outside app storage")

    validation = profile.get("validation")
    if (not isinstance(validation, dict) or validation.get("receipt") != ".complete" or
            validation.get("manifest") != "pack.json" or validation.get("criticalFiles") != list(PROFILE_CRITICAL)):
        raise GraphicsProfileError("invalid graphics profile validation metadata")

    receipt = profile_file(pack, ".complete")
    try:
        if receipt.stat().st_size > PROFILE_RECEIPT_LIMIT:
            raise GraphicsProfileError("graphics profile receipt is too large")
        if receipt.read_text(encoding="utf-8").strip() != version:
            raise GraphicsProfileError("graphics profile receipt does not match the selection")
    except (OSError, UnicodeError) as error:
        raise GraphicsProfileError("graphics profile receipt is unreadable") from error
    manifest_path = profile_file(pack, "pack.json")
    try:
        if manifest_path.stat().st_size > PROFILE_MANIFEST_LIMIT:
            raise GraphicsProfileError("graphics profile manifest is too large")
        manifest_bytes = manifest_path.read_bytes()
    except OSError as error:
        raise GraphicsProfileError("graphics profile manifest is unreadable") from error
    if hashlib.sha256(manifest_bytes).hexdigest() != version:
        raise GraphicsProfileError("graphics profile manifest does not match the selection")
    try:
        manifest = json.loads(manifest_bytes.decode("utf-8"))
    except (UnicodeError, ValueError, TypeError, RecursionError) as error:
        raise GraphicsProfileError("graphics profile manifest is unreadable") from error
    if not isinstance(manifest, dict) or manifest.get("format") != 1:
        raise GraphicsProfileError("graphics profile manifest has an unsupported format")

    described = {}
    wrapper = manifest.get("wrapper")
    if not isinstance(wrapper, dict) or wrapper.get("path") != "run-proton.py":
        raise GraphicsProfileError("graphics profile manifest has an invalid wrapper")
    described[wrapper.get("path")] = wrapper
    archives = manifest.get("archives")
    if not isinstance(archives, list):
        raise GraphicsProfileError("graphics profile manifest has no archives")
    archive_ids = set()
    for archive in archives:
        if (not isinstance(archive, dict) or archive.get("id") not in ("dxvk", "wsi") or
                archive.get("id") in archive_ids or not isinstance(archive.get("files"), list)):
            raise GraphicsProfileError("graphics profile manifest has an invalid archive")
        archive_ids.add(archive["id"])
        for entry in archive["files"]:
            relative = entry.get("path") if isinstance(entry, dict) else None
            if not isinstance(relative, str) or relative in described:
                raise GraphicsProfileError("graphics profile manifest has an invalid file")
            described[relative] = entry
    if archive_ids != {"dxvk", "wsi"}:
        raise GraphicsProfileError("graphics profile manifest is missing an archive")

    for relative in PROFILE_CRITICAL:
        if relative not in described:
            raise GraphicsProfileError("graphics profile manifest omits %s" % relative)
    for relative, entry in described.items():
        if not isinstance(relative, str) or not isinstance(entry, dict):
            raise GraphicsProfileError("graphics profile manifest has an invalid file")
        size, checksum = entry.get("size"), entry.get("sha256")
        if (not isinstance(size, int) or isinstance(size, bool) or size < 0 or
                not isinstance(checksum, str) or not PROFILE_VERSION.fullmatch(checksum.lower())):
            raise GraphicsProfileError("graphics profile metadata is invalid for %s" % relative)
        target = profile_file(pack, relative)
        try:
            valid = target.is_file() and target.stat().st_size == size and file_sha256(target) == checksum.lower()
        except OSError:
            valid = False
        if not valid:
            raise GraphicsProfileError("graphics profile file is missing or corrupt: %s" % relative)
        if relative == "run-proton.py" and not os.access(target, os.X_OK):
            raise GraphicsProfileError("graphics profile wrapper is not executable")
    validate_profile_tree(pack, set(described) | {".complete", "pack.json"})

    expected = {
        "DROIDDECK_PROTON_WRAPPER": str(published_pack / "run-proton.py"),
        "HYBRIS_BC_TEXTURES": "dxvk",
        "VK_LAYER_PATH": "%s:%s" % (published_pack / "wsi", hybris / "lib"),
        "VK_INSTANCE_LAYERS": "VK_LAYER_window_system_integration:VK_LAYER_HYBRIS_compat",
        "ENABLE_GAMESCOPE_WSI": "0",
        "VK_LOADER_LAYERS_DISABLE": "*gamescope*",
        "DISABLE_WSI_LAYER": None,
        "PROTON_USE_WINED3D": None,
        "DISABLE_VK_LAYER_VALVE_steam_fossilize_1": "1",
        "ENABLE_VK_LAYER_VALVE_steam_fossilize_1": None,
    }
    managed = profile.get("managedEnvironment")
    if not isinstance(managed, dict) or set(managed) != set(PROFILE_KEYS) or managed != expected:
        raise GraphicsProfileError("graphics profile managed environment is invalid")
    return managed


def apply_graphics_profile(env, config):
    profile = config.get("graphicsProfile")
    if profile is None:
        return env
    managed = validate_profile(profile)
    result = env.copy()
    for name, value in managed.items():
        if value is None:
            result.pop(name, None)
        else:
            result[name] = value
    return result


def apply_graphics_profile_for_launch(command, env, config):
    """Apply the managed profile only to a nonzero-app-id Proton game launch."""
    if (not game_id(env) or len(command) < 2 or command[1] != "waitforexitandrun" or
            config.get("graphicsProfile") is None):
        return env
    return apply_graphics_profile(env, config)


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


# A .NET (CoreCLR) runtime under FEX crashes in the runtime itself unless memory ordering is fully
# emulated and multiblock is off: the Stability preset.
DOTNET_FEX = {
    "FEX_TSOENABLED": "1",
    "FEX_VECTORTSOENABLED": "1",
    "FEX_MEMCPYSETTSOENABLED": "1",
    "FEX_HALFBARRIERTSOENABLED": "1",
    "FEX_X87REDUCEDPRECISION": "0",
    "FEX_MULTIBLOCK": "0",
}


def game_files(exe):
    """Lower-cased names of the files next to the game's executable and one directory below."""
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:
    """What a fix gets to look at: the executable, its launch arguments and the files beside it."""

    def __init__(self, exe, args):
        self.exe = exe
        self.args = args
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)


# Each fix looks at a Game and returns (environment, extra arguments, note) for the games it
# applies to, or None. Adding one is writing a function and decorating it.
FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        return DOTNET_FEX, [], ".NET runtime: FEX with full TSO and without multiblock"


@fix
def godot_vulkan(game):
    # Godot 4 on Direct3D 12 through VKD3D-Proton fails to create its swap chain and runs behind a
    # black window; its own Vulkan renderer draws.
    if is_godot(game) and not game.has_arg("--rendering-driver"):
        return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"


@fix
def godot_sentry(game):
    # The Sentry GDExtension's native crash handler takes the .NET runtime down under FEX. Godot
    # loads it on demand and carries on without it.
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry:
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


def engine_fixes(exe, args):
    """Environment and extra arguments a game needs because of what it is built with."""
    game = Game(exe, args)
    env, extra, notes = {}, [], []
    for check in FIXES:
        found = check(game)
        if found:
            env.update(found[0])
            extra += found[1]
            notes.append(found[2])
    return env, extra, notes


def win_components(compat, app_id):
    """The game's Windows components put into its prefix; returns their WINEDLLOVERRIDES entries."""
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def apply_config(env, config, app_id, fixes=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(config.get("shared", {}))
    for name, value in (fixes or {}).items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    # The app's texture filtering (Display page), as DXVK options appended after the profiles so
    # a DXVK_CONFIG entry of the user's keeps its own.
    dxvk = config.get("dxvkConfig")
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    return result


GAME_DEBUG_CHANNELS = (
    "timestamp", "pid", "tid", "seh", "unwind", "threadname", "debugstr", "loaddll", "mscoree",
)
WINE_DEBUG_SELECTOR = re.compile(r"(?:(trace|warn|err|fixme))?([+-])([A-Za-z_][A-Za-z0-9_]*)")


def game_debug_channels(*values):
    """Normalize Wine selectors, retaining custom channels before required diagnostics."""
    selectors = {}
    for value in values:
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            continue
        for part in value.split(","):
            part = part.strip()
            match = WINE_DEBUG_SELECTOR.fullmatch(part)
            if match is None:
                continue
            key = (match[1] or "", match[3])
            # Move the last value to the end: global +/-all and per-class selectors
            # have ordered semantics, so replacing a value in its old position is wrong.
            selectors.pop(key, None)
            selectors[key] = part
    for channel in GAME_DEBUG_CHANNELS:
        key = ("", channel)
        selectors.pop(key, None)
        selectors[key] = "+" + channel
    formatted = ",".join(selectors.values())
    if len(formatted) > 8192:
        formatted = ",".join("+" + channel for channel in GAME_DEBUG_CHANNELS)
    return formatted


def apply_game_debug_logs(env, config, debug_dir):
    """Apply app-owned diagnostics to a real game, without editing its launch command."""
    if not isinstance(config, dict) or config.get("version") != 1 or config.get("gameDebugLogs") is not True:
        return env
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or len(debug_dir) > 8192
            or not os.path.isabs(debug_dir) or not os.path.isdir(debug_dir)):
        print("droiddeck-game-env: game debug logs skipped; session log directory unavailable", file=sys.stderr)
        return env
    result = dict(env)
    result.update({
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": debug_dir,
        "PROTON_CRASH_REPORT_DIR": debug_dir,
        "DXVK_LOG_PATH": debug_dir,
        "DXVK_LOG_LEVEL": "debug",
        "VKD3D_DEBUG": "info",
        "WINEDEBUG": game_debug_channels(env.get("WINEDEBUG"), env.get("PROTON_LOG")),
    })
    return result


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    """DROIDDECK_FORCE_SSBS=1 (a game's or the shared environment): preload libssbs.so into this
    Proton's Wine, which then keeps PSTATE.SSBS set across signal returns - speculative store
    bypass stays allowed, as force_ssbs.diff does inside a rebuilt ntdll. ARM64 Protons only: the
    library is aarch64 and only arm64 Wine has the signal path it fixes."""
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


def mark_install_scripts(command, env):
    """The client is about to run a game's install scripts (iscriptevaluator.exe): mark every process
    in them as already run first, so no redistributable installer starts - on first launch the
    shared ones may still be downloading, and on ARM64 Proton the VC++ ones stop with an error."""
    if not any(arg.lower().replace("\\", "/").endswith("iscriptevaluator.exe") for arg in command):
        return
    root = env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
    scripts = [path for path in scripts if os.path.isfile(path)]
    if not scripts:
        return
    try:
        subprocess.run([SEED_REDISTS, root], env=dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts)),
                       stdout=sys.stderr, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)


def proton_launch(command, env):
    """Apply an explicitly selected wrapper only to a real game launch."""
    wrapper = env.get("DROIDDECK_PROTON_WRAPPER")
    if not wrapper or not game_id(env) or len(command) < 2 or command[1] != "waitforexitandrun":
        return command
    if not os.path.isabs(wrapper) or not os.access(wrapper, os.X_OK):
        raise OSError("DROIDDECK_PROTON_WRAPPER must name an executable absolute path")
    return [wrapper, *command]


def exec_proton(command, env):
    command = proton_launch(command, env)
    os.execvpe(command[0], command, env)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    env = os.environ.copy()
    debug_dir = env.get("BL_DEBUG_DIR", "")
    mark_install_scripts(command, env)
    app_id = game_id(env)
    if app_id:
        waiting = len(command) > 1 and command[1] == "waitforexitandrun"
        fixes = {}
        if waiting:
            fixes, extra, notes = engine_fixes(command[2], command[3:]) if len(command) > 2 else ({}, [], [])
            for note in notes:
                print("droiddeck-game-env: " + note, file=sys.stderr)
            command += extra
            components = win_components(env.get("STEAM_COMPAT_DATA_PATH", ""), app_id)
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
        path = Path.home() / ".config/droiddeck/game-environment.json"
        config = None
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
            if waiting:
                env = apply_config(env, config, app_id, fixes)
            else:
                env = apply_config(env, sync_config(config, app_id), app_id)
        except FileNotFoundError:
            if waiting:
                env = apply_config(env, {"version": 1}, app_id, fixes)
        except (OSError, ValueError, TypeError, AttributeError):
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        if waiting and isinstance(config, dict) and config.get("graphicsProfile") is not None:
            try:
                # This app-owned profile owns its keys and is intentionally applied after the
                # user's shared/game environment and DroidDeck's engine fixes.
                env = apply_graphics_profile_for_launch(command, env, config)
            except GraphicsProfileError as error:
                print("droiddeck-game-env: experimental graphics profile unavailable (%s); repair it in DroidDeck" % error,
                      file=sys.stderr)
                return 1
        if waiting:
            before_debug = env
            env = apply_game_debug_logs(env, config, debug_dir)
            if env is not before_debug:
                print("droiddeck-game-env: game debug logs enabled for this launch", file=sys.stderr)
    env = force_ssbs(command, env)
    sync = load_sync()
    launch, launch_env = select_sync(command, env, sync)
    if launch[0] != command[0]:
        try:
            exec_proton(launch, launch_env)
        except OSError as error:
            print("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error), file=sys.stderr)
            launch, launch_env = command, without_pack(launch_env, env)
            record_stock(sync, launch, launch_env)
    exec_proton(launch, launch_env)


if __name__ == "__main__":
    sys.exit(main())
